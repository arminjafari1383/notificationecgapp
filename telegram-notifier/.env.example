# =========================
# Existing Django PostgreSQL
# Same values as django-backend
# =========================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=mydb
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_SSLMODE=disable

# Django table names from your uploaded backend
APPUSER_TABLE=core_appuser
REFERRAL_TABLE=core_referrallevel

# =========================
# Worker behavior
# =========================
APP_TIMEZONE=Asia/Tehran
TIMER_POLL_SECONDS=30
REFERRAL_POLL_SECONDS=60
REFERRAL_REMINDER_HOUR=12
REFERRAL_REMINDER_MINUTE=0
DB_BATCH_SIZE=500
SEND_DELAY_SECONDS=0.06
ENABLE_TIMER_NOTIFICATIONS=true
ENABLE_REFERRAL_REMINDERS=true

# Persists dedup/retry state across container restarts
STATE_DB_PATH=/data/notifier.sqlite3

# Existing Docker network name. Change if your compose network has another name.
DOCKER_NETWORK=projectecg_default
